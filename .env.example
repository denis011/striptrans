# Kopiraj u .env i prilagodi po potrebi.
# OCR: llama-server na Windows hostu (make llm); folder sa vulkan\llama-server.exe i models\
# auto: llama-server ako je instaliran, inače Ollama (`ollama pull qwen2.5vl:7b`); ili izričito llama-server / ollama
OCR_SERVER=auto
LLAMA_SERVER_DIR=C:\llm-bench
LLAMA_SERVER_PORT=8081
LLAMA_SERVER_URL=http://host.docker.internal:8081
# Prevod i glosar idu preko OpenRouter-a; bez ključa prevod ne radi. Ključ sa https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modeli ponuđeni u aplikaciji (prefiks "or:" znači OpenRouter)
OPENROUTER_MODELS=or:google/gemini-3.1-flash-lite,or:qwen/qwen3.7-plus,or:google/gemma-4-31b-it,or:anthropic/claude-sonnet-5
# Podrazumevani model za prevod
TRANSLATION_MODEL=or:google/gemini-3.1-flash-lite
